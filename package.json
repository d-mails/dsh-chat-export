{
  "name": "dsh-chat-export",
  "version": "1.7.0",
  "description": "Export a DeepSeek Harness conversation to Markdown, HTML, or PDF. Choose any session, pick the turns to keep, ignore the questioner's messages, and optionally include thinking and tool calls.",
  "license": "MIT",
  "author": "dsh-chat-export contributors",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "conversation-export",
    "markdown",
    "html",
    "pdf"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d-mails/dsh-chat-export.git"
  },
  "homepage": "https://github.com/d-mails/dsh-chat-export#readme",
  "bugs": {
    "url": "https://github.com/d-mails/dsh-chat-export/issues"
  },
  "publishConfig": { "access": "public" },
  "scripts": {
    "test": "node --test test/core.test.js test/client.test.js test/handlers.test.js"
  },
  "engines": { "node": ">=20" }
}
